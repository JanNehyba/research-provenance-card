{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.org/rpc-v0.1.schema.json",
  "title": "Research Provenance Card v0.1",
  "type": "object",
  "required": [
    "rpc_version",
    "paper",
    "human_guarantor",
    "ai_systems",
    "activities"
  ],
  "additionalProperties": false,
  "properties": {
    "rpc_version": {
      "const": "0.1"
    },
    "paper": {
      "type": "object",
      "required": ["title", "version", "pdf_sha256"],
      "additionalProperties": false,
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "venue": {"type": "string"},
        "venue_paper_id": {"type": "string"},
        "pdf_sha256": {
          "type": "string",
          "pattern": "^[a-fA-F0-9]{64}$"
        }
      }
    },
    "human_guarantor": {
      "type": "object",
      "required": ["orcid", "name", "assertion_timestamp"],
      "additionalProperties": false,
      "properties": {
        "orcid": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
        },
        "name": {"type": "string", "minLength": 1},
        "assertion_timestamp": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "ai_systems": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "provider",
          "model_family",
          "model_version_or_snapshot",
          "interface"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "model_family": {"type": "string", "minLength": 1},
          "model_version_or_snapshot": {"type": "string", "minLength": 1},
          "interface": {"type": "string", "minLength": 1},
          "operator_orcid": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{4}-\\d{4}-\\d{3}[\\dX]$"
          },
          "agent_identifier": {
            "type": "object",
            "required": ["scheme", "value"],
            "additionalProperties": false,
            "properties": {
              "scheme": {"type": "string", "minLength": 1},
              "value": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    },
    "activities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["role_id", "actor_id", "evidence_level"],
        "additionalProperties": false,
        "properties": {
          "role_id": {"type": "string", "minLength": 1},
          "actor_id": {"type": "string", "minLength": 1},
          "evidence_level": {
            "type": "string",
            "enum": [
              "declared",
              "artifact_linked",
              "independently_attested",
              "reproduced"
            ]
          },
          "description": {"type": "string"},
          "artifact_refs": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "access_status"],
        "additionalProperties": false,
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "type": {
            "type": "string",
            "enum": ["prompt", "log", "dataset", "code", "model_output", "other"]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "access_status": {
            "type": "string",
            "enum": ["public", "embargoed", "on_request", "restricted", "not_retained"]
          },
          "restriction_reason": {"type": "string"}
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "access_status": {
                  "enum": ["embargoed", "on_request", "restricted", "not_retained"]
                }
              }
            },
            "then": {
              "required": ["restriction_reason"]
            }
          }
        ]
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["check_type", "result", "subject_sha256", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "check_type": {"type": "string", "minLength": 1},
          "result": {"type": "string", "enum": ["pass", "fail", "partial"]},
          "details": {"type": "string"},
          "tool": {"type": "string"},
          "subject_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "timestamp": {"type": "string", "format": "date-time"}
        }
      }
    },
    "attestations": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["attestor", "scope", "subject_sha256", "timestamp"],
        "additionalProperties": false,
        "properties": {
          "attestor": {
            "type": "object",
            "required": ["scheme", "value"],
            "additionalProperties": false,
            "properties": {
              "scheme": {"type": "string", "enum": ["orcid", "ror"]},
              "value": {"type": "string", "minLength": 1}
            }
          },
          "scope": {"type": "string", "minLength": 1},
          "method": {"type": "string"},
          "subject_sha256": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{64}$"
          },
          "timestamp": {"type": "string", "format": "date-time"}
        }
      }
    },
    "supersedes": {
      "type": "string",
      "minLength": 1
    }
  }
}
